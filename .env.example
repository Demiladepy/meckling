# Copy to .env and fill in. Never commit .env.

# Network the app and agent use: local (anvil fork of mainnet) | testnet | mainnet
NETWORK=local

# RPC (QuickNode preferred; public RPC as fallback)
MONAD_RPC_URL=https://rpc.monad.xyz
MONAD_TESTNET_RPC_URL=https://testnet-rpc.monad.xyz
LOCAL_RPC_URL=http://127.0.0.1:8545

# Deployer key (contracts/script/Deploy.s.sol). Needs ~2 MON.
DEPLOYER_PRIVATE_KEY=

# Nansen (server-side only). Required for the app underwriting UI.
NANSEN_API_KEY=
# Local engineering only: allow labelled fixture underwriting when the key is absent.
# Never set this on the judge-facing deploy.
# ALLOW_NANSEN_FIXTURE=1

# Agent runtime (services/agent). The session key can only trade through its MandateAccount; it can never withdraw.
MANDATE_ACCOUNT=
AGENT_SESSION_PRIVATE_KEY=
AGENT_LOOP_BLOCKS=30
AGENT_VENUE_LEVERAGE=15
AGENT_SLIPPAGE_BPS=100
# Optional local script for repeatable agent loops. Do not use on the Nansen demo recording.
# DEMO_MODE=1

# Agent model: claude | kimi
LLM_PROVIDER=claude
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5
CLAUDE_EFFORT=high
KIMI_API_KEY=
KIMI_BASE_URL=
KIMI_MODEL=

# The agent the app offers backers (addresses only; the app never holds agent keys).
AGENT_OPERATOR_ADDRESS=
AGENT_SESSION_ADDRESS=

# Keeper (M2)
KEEPER_PRIVATE_KEY=
# eth_getLogs range per request: 100 on the public RPC, 1000 on QuickNode (both measured).
LOG_RANGE_BLOCKS=

# Envio (M2)
ENVIO_GRAPHQL_URL=
# Envio API token for HyperSync / Envio Cloud (https://envio.dev/app/api-tokens)
ENVIO_API_TOKEN=

# QuickNode (Metropolis perk). The promo/account key; the RPC URL itself goes in MONAD_TESTNET_RPC_URL.
QUICKNODE_KEY=

# Zerion builder plan. Unused today (see docs/ideas.md).
ZERION_API_KEY=

# Upstash Redis: agent records and judge-faucet rate limits (https://console.upstash.com)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Judge faucet (testnet only): a dedicated wallet funded with test MON and AUSD
FAUCET_PRIVATE_KEY=
FAUCET_ADDRESS=
