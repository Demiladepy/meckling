# Copy to .env and fill in. Never commit .env.

# Network the app and agent use: local (anvil fork of mainnet) | testnet | mainnet
NETWORK=local

# RPC (QuickNode preferred; public RPC as fallback)
MONAD_RPC_URL=https://rpc.monad.xyz
MONAD_TESTNET_RPC_URL=https://testnet-rpc.monad.xyz
LOCAL_RPC_URL=http://127.0.0.1:8545

# Deployer key (contracts/script/Deploy.s.sol). Needs ~2 MON.
DEPLOYER_PRIVATE_KEY=

# Agent runtime (services/agent). The session key can only trade through its MandateAccount; it can never withdraw.
MANDATE_ACCOUNT=
AGENT_SESSION_PRIVATE_KEY=
AGENT_LOOP_BLOCKS=30
AGENT_VENUE_LEVERAGE=15
AGENT_SLIPPAGE_BPS=100
# DEMO_MODE=1 runs the disclosed scripted demo (one deliberate 12x attempt, then trades inside the limits).
DEMO_MODE=

# Agent model: claude | kimi
LLM_PROVIDER=claude
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5
CLAUDE_EFFORT=high
KIMI_API_KEY=
KIMI_BASE_URL=
KIMI_MODEL=

# The agent the app offers backers (addresses only; the app never holds agent keys).
AGENT_OPERATOR_ADDRESS=
AGENT_SESSION_ADDRESS=

# Nansen (server-side only). Without it, underwriting uses labelled sample data.
NANSEN_API_KEY=

# Keeper (M2)
KEEPER_PRIVATE_KEY=

# Envio (M2)
ENVIO_GRAPHQL_URL=
