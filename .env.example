# Copy to .env and fill in. Never commit .env.

# RPC (QuickNode preferred; public RPC as fallback)
MONAD_RPC_URL=https://rpc.monad.xyz
MONAD_TESTNET_RPC_URL=https://testnet-rpc.monad.xyz

# Deployer / keeper / agent keys (hex, 0x-prefixed). Agent key is a session key only.
DEPLOYER_PRIVATE_KEY=
KEEPER_PRIVATE_KEY=
AGENT_SESSION_PRIVATE_KEY=

# Perpl
PERPL_API_BASE=https://testnet.perpl.xyz/api
PERPL_EXCHANGE=0x1964c32f0be608e7d29302aff5e61268e72080cc

# Nansen
NANSEN_API_KEY=

# Agent model
LLM_PROVIDER=
LLM_API_KEY=

# Envio
ENVIO_GRAPHQL_URL=
